rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // solo nombre y puntos, nombre de 1 a 20 letras y puntos entre 0 y el maximo del modo
    function datosValidos(maximo) {
      let d = request.resource.data;
      return d.keys().hasOnly(['nombre', 'puntos'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 20
        && d.puntos is int && d.puntos >= 0 && d.puntos <= maximo;
    }

    // normal: 4 juegos x 100 = 400 como maximo
    match /ranking_normal/{id} {
      allow read: if true;
      allow create: if datosValidos(400);
      allow update: if datosValidos(400) && request.resource.data.puntos > resource.data.puntos;
    }

    // hardcore: 4 juegos x 200 = 800 como maximo
    match /ranking_hardcore/{id} {
      allow read: if true;
      allow create: if datosValidos(800);
      allow update: if datosValidos(800) && request.resource.data.puntos > resource.data.puntos;
    }
  }
}
